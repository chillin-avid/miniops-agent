# 对话模型：不配置也能使用 MiniOps 的离线兜底模式。
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-me
LLM_MODEL_ID=replace-me
LLM_TIMEOUT=60

# 知识库文本向量模型；文档和问题必须使用同一个模型与维度。
EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL_ID=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=768

# 重排复用 EMBEDDING_API_KEY，只对混合召回后的少量候选精排。
RERANK_BASE_URL=https://your-rerank-endpoint/v1
RERANK_MODEL_ID=qwen3-rerank
RERANK_CANDIDATES=8

# 正式运行日志使用真实时间戳；其他 JSONL 目录用分号分隔。
MINIOPS_RUNTIME_LOG_PATH=data/runtime-logs/miniops.jsonl
MINIOPS_LOG_DIRECTORIES=
MINIOPS_LOG_MAX_SCAN_BYTES=2000000
# 单个日志最多约 5MB，并保留 5 个历史文件。
MINIOPS_LOG_MAX_FILE_BYTES=5000000
MINIOPS_LOG_BACKUP_COUNT=5
